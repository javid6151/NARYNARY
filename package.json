{
    "name": "zipnary",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "dev:portals": "node scripts/dev-portals.mjs",
        "build": "tsc -b && vite build",
        "lint": "eslint .",
        "preview": "vite preview",
        "typecheck": "tsc -b --noEmit",
        "test": "vitest run",
        "db:start": "supabase start -x edge-runtime,imgproxy,logflare,vector,supavisor",
        "db:reset": "supabase db reset",
        "db:types": "node scripts/gen-types.mjs",
        "seed:dev": "node scripts/seed-dev.mjs",
        "test:rls": "node scripts/rls-test.mjs"
    },
    "dependencies": {
        "@supabase/supabase-js": "^2.49.4",
        "lucide-react": "^0.475.0",
        "react": "^19.1.0",
        "react-dom": "^19.1.0",
        "react-router-dom": "^6.30.0"
    },
    "devDependencies": {
        "@eslint/js": "^9.25.0",
        "@tailwindcss/vite": "^4.1.4",
        "@types/react": "^19.1.2",
        "@types/react-dom": "^19.1.2",
        "@vitejs/plugin-react": "^4.4.1",
        "eslint": "^9.25.0",
        "eslint-plugin-react-hooks": "^5.2.0",
        "eslint-plugin-react-refresh": "^0.4.19",
        "globals": "^16.0.0",
        "supabase": "^2.121.0",
        "tailwindcss": "^4.1.4",
        "typescript": "~5.8.3",
        "typescript-eslint": "^8.30.1",
        "vite": "^6.3.5",
        "vitest": "^3.1.1"
    }
